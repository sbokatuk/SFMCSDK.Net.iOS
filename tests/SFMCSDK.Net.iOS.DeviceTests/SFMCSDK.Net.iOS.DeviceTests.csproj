<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Which of the package's target frameworks to exercise. Overriding TargetFramework directly on
      the command line breaks restore, so it goes through a property of our own.
    -->
    <SfmcDeviceTargetFramework Condition=" '$(SfmcDeviceTargetFramework)' == '' ">net9.0-ios18.0</SfmcDeviceTargetFramework>
    <TargetFramework>$(SfmcDeviceTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <ApplicationId>com.sbokatuk.sfmcsdknet.devicetests</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>

    <!--
      The smoke tests report through stdout, which the runner script streams back with
      `simctl launch` in console-pty mode. Quietening the Mono logger keeps that stream to the
      test output rather than runtime chatter.
    -->
    <MtouchExtraArgs>--setenv=MONO_LOG_LEVEL=error</MtouchExtraArgs>
  </PropertyGroup>

  <!--
    Keychain access on the simulator, for the net8 and net9 legs.

    The native SDK keeps its encryption keys in the keychain and does not initialize without it:
    initializeSdk returns, nothing comes up, the completion block is never called and identity
    edits are never applied - silently. On the simulator the keychain answers
    errSecMissingEntitlement (-34018) to an app that carries no entitlements, and the .NET 8 and
    .NET 9 iOS workloads build simulator apps exactly that way: linker-signed, nothing embedded.
    The .NET 10 workload embeds simulated entitlements on its own, which is why the same test
    used to behave differently per target framework and the difference was put down to the SDK.

    So the simulator build is given one entitlement of its own. CodesignRequireProvisioningProfile
    is off because asking for entitlements otherwise makes the .NET 8/9 workloads look for a
    provisioning profile, and a CI runner has none.

    A target rather than a property group, so that device builds are not affected. The iOS SDK
    picks the default runtime identifier (simulator for a build, ios-arm64 for a publish) only
    after this file's properties are evaluated, so a property condition sees an empty
    RuntimeIdentifier in both cases. A target condition runs after that choice. BuildOnlySettings
    is the first step of every iOS build chain (.NET 8, 9 and 10), ahead of the signing and
    entitlement targets that read these two properties. A device build is signed with a real
    profile, which always carries the application identifier the keychain wants.
  -->
  <Target Name="UseSimulatorKeychainEntitlement" BeforeTargets="BuildOnlySettings"
          Condition="$(RuntimeIdentifier.StartsWith('iossimulator'))">
    <PropertyGroup>
      <CodesignEntitlements>$(MSBuildProjectDirectory)/Entitlements.Simulator.plist</CodesignEntitlements>
      <CodesignRequireProvisioningProfile>false</CodesignRequireProvisioningProfile>
    </PropertyGroup>
  </Target>

  <!--
    The e2e deliberately consumes the packed NuGet from ./artifacts rather than a
    ProjectReference, so it exercises the artifact that actually gets published. See NuGet.config
    for the local feed.
  -->
  <PropertyGroup>
    <SfmcPackageVersion Condition=" '$(SfmcPackageVersion)' == '' ">$(VersionPrefix)</SfmcPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SFMCSDK.Net.iOS" Version="$(SfmcPackageVersion)" />
  </ItemGroup>

</Project>

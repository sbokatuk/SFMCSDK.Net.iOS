<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
		  Which of the package's target frameworks the sample is built against. Overriding
		  TargetFramework directly, or asking the CLI for a framework the project does not declare,
		  breaks restore - so the choice goes through a property of our own, the same way the
		  device tests project does it.
		-->
		<SfmcSampleTargetFramework Condition=" '$(SfmcSampleTargetFramework)' == '' ">net10.0-ios26.0</SfmcSampleTargetFramework>
		<TargetFramework>$(SfmcSampleTargetFramework)</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>SFMCSDK.Net.iOS.Example</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>SFMCSDK.Net.iOS.Example</ApplicationTitle>
		<ApplicationId>com.sbokatuk.sfmcsdknet.example</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
	</PropertyGroup>

	<!--
	  Keychain access on the simulator. The SFMC SDK keeps its keys in the keychain and does not
	  initialize without it - silently: no completion block, no identity edits. A simulator app
	  with no entitlements is refused the keychain (errSecMissingEntitlement, -34018), and that
	  is how the .NET 8 and .NET 9 iOS workloads build one; the .NET 10 workload embeds simulated
	  entitlements by itself. CodesignRequireProvisioningProfile is off because asking for
	  entitlements otherwise sends the .NET 8/9 workloads looking for a provisioning profile.

	  A target rather than a property group, so that device builds are untouched. The iOS SDK picks
	  the default runtime identifier (simulator for a build, ios-arm64 for a publish) only after this
	  file's properties are evaluated, so a property condition sees an empty RuntimeIdentifier in both
	  cases and cannot tell them apart. A target condition runs after that choice. BuildOnlySettings
	  is the first step of every iOS build chain (.NET 8, 9 and 10), ahead of the signing and
	  entitlement targets that read these two properties. A device build keeps its own signing: the
	  provisioning profile carries the application identifier the keychain needs.
	-->
	<Target Name="UseSimulatorKeychainEntitlement" BeforeTargets="BuildOnlySettings"
	        Condition="$(RuntimeIdentifier.StartsWith('iossimulator'))">
		<PropertyGroup>
			<CodesignEntitlements>$(MSBuildProjectDirectory)/Platforms/iOS/Entitlements.Simulator.plist</CodesignEntitlements>
			<CodesignRequireProvisioningProfile>false</CodesignRequireProvisioningProfile>
		</PropertyGroup>
	</Target>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.2" />
	</ItemGroup>

	<!--
	  Resolved from ./artifacts through the local feed in the repository's NuGet.config, not from
	  nuget.org, so the sample always exercises your local build. Run ./build/BuildNugets.sh first.
	  Pass -p:SfmcPackageVersion=5.0.0.1-rc.1 to point it at a specific build.

	  net10 to match the sibling repositories' samples; the package itself targets net8, net9 and
	  net10. Building this needs the .NET 10 SDK, which the repository's global.json does not
	  select - see the command in the README.
	-->
	<PropertyGroup>
		<SfmcPackageVersion Condition=" '$(SfmcPackageVersion)' == '' ">$(VersionPrefix)</SfmcPackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SFMCSDK.Net.iOS" Version="$(SfmcPackageVersion)" />
	</ItemGroup>

</Project>
